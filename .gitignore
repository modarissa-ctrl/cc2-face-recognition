### facerec
# openFrameworks install + download cache (fetched by scripts/bootstrap.py)
/of/
/.cache/

# ONNX models (fetched by scripts/bootstrap.py)
/facerec/bin/data/models/

# build output (bin/data is source-controlled, binaries are not)
/facerec/bin/*
!/facerec/bin/data/
/facerec/obj/

# projectGenerator output (regenerated by scripts/bootstrap.py; addons.make is ours)
/facerec/*.xcodeproj/
/facerec/Project.xcconfig
/facerec/openFrameworks-Info.plist
/facerec/of.entitlements
/facerec/Makefile
/facerec/config.make
/facerec/.vscode/
/facerec/*.sln
/facerec/*.vcxproj*

